{
  "mcpServers": {
    "smartbear-zephyr": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${workspaceFolder}/node_modules/@smartbear/mcp/dist/index.js"
      ],
      "env": {
        "ZEPHYR_API_TOKEN": "${env:ZEPHYR_API_TOKEN}",
        "ZEPHYR_BASE_URL": "https://eu.api.zephyrscale.smartbear.com/v2",
        "MCP_CLIENTS": "Zephyr"
      }
    }
  }
}
