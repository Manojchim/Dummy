PORT=4173
HOST=127.0.0.1
STRIDE_DATA_DIR=./data
STRIDE_ADMIN_TOKEN=
STRIDE_WIKIMEDIA_AUTO_DISCOVERY=true

# Amazon India Creators API. Requires Associates enrollment, approved API access,
# a valid partner tag, and compliance with the Associates Program agreement.
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_PARTNER_TAG=
AMAZON_CREATORS_MARKETPLACE=www.amazon.in

# Authorized JSON feed contract; configure only with partner/feed access and
# explicit product-image reuse rights. Each image host must be allowlisted.
STRIDE_FLIPKART_FEED_URL=
STRIDE_FLIPKART_FEED_TOKEN=
STRIDE_FLIPKART_IMAGE_HOSTS=
STRIDE_BRAND_FEED_URL=
STRIDE_BRAND_FEED_TOKEN=
STRIDE_BRAND_IMAGE_HOSTS=

# Zephyr Scale Cloud API (US region). Replace the placeholder in your local .env only.
ZEPHYR_SCALE_API_BASE_URL=https://api.zephyrscale.smartbear.com/v2
ZEPHYR_SCALE_API_TOKEN=ABCD_REPLACE_WITH_ACTUAL_TOKEN
